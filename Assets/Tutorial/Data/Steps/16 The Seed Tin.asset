        locked: 1
    - rid: 671328379574943827
      type: {class: StoryCardAction, ns: GardenGrowers.Tutorial.Actions, asm: Assembly-CSharp}
      data:
        title: Mkhulu's Seed Tin
        body: An old, rusty tin. Inside are seeds you have never seen before, and
          a folded piece of paper.
        icon: {fileID: 21300000, guid: 85e17b1ad5723e14eb39ee383b4f6be7, type: 3}
        waitForKey: 1
        autoSeconds: 4
    - rid: 671328379574943828
      type: {class: GogoSayAction, ns: GardenGrowers.Tutorial.Actions, asm: Assembly-CSharp}
      data:
        lines:
          lines:
          - text: Long ago, before the rubbish came, Mkhulu grew a garden that fed
              our whole street.
            mood: 3
            gesture: 0
            holdSeconds: 0
          - text: No child went to bed hungry. Not one.
            mood: 3
            gesture: 0
            holdSeconds: 0
          - text: These are his seeds. You won't find them in any shop.
            mood: 4
            gesture: 0
            holdSeconds: 0
          - text: And look... he left a note.
            mood: 4
            gesture: 0
            holdSeconds: 0
          focusCamera: 1
          waitForInput: 1
        waitUntilFinished: 1
    - rid: 671328379574943829
      type: {class: StoryCardAction, ns: GardenGrowers.Tutorial.Actions, asm: Assembly-CSharp}
      data:
        title: Mkhulu's Note
        body: <i>"Plant them where the water sleeps."</i>
        icon: {fileID: 0}
        waitForKey: 1
        autoSeconds: 4
    - rid: 671328379574943830
      type: {class: GogoSayAction, ns: GardenGrowers.Tutorial.Actions, asm: Assembly-CSharp}
      data:
        lines:
          lines:
          - text: I never understood what it meant.
            mood: 5
            gesture: 6
            holdSeconds: 0
          - text: But you, my clever child... I think you can find out.
            mood: 1
            gesture: 1
            holdSeconds: 0
          focusCamera: 1
          waitForInput: 1
        waitUntilFinished: 1
    - rid: 671328379574943831
      type: {class: BannerAction, ns: GardenGrowers.Tutorial.Actions, asm: Assembly-CSharp}
      data:
        text: 'NEW GOAL: Find Mkhulu''s lost garden'
        seconds: 4
        playSound: 1
    - rid: 671328379574943832
      type: {class: WaitAction, ns: GardenGrowers.Tutorial.Actions, asm: Assembly-CSharp}
