  intro:
    lines:
    - text: You did so well today, mzukulu. Now I want to show you something.
      mood: 1
      gesture: 0
      holdSeconds: 0
    - text: This old tin belonged to your grandfather. Mkhulu.
      mood: 6
      gesture: 0
      holdSeconds: 0
    focusCamera: 1
    waitForInput: 1
