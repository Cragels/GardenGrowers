  m_Name: 13 Sell At The Stall
  m_EditorClassIdentifier: 
  objective: Sell your harvest at Gogo's stall
  designNote: 'Community angle: selling at fair prices to neighbours whose kids go
    to school hungry. Gogo runs the stall.'
  targetId: stall
  gogo: 2
  gogoTargetId: stallSpot
  intro:
    lines:
    - text: Our neighbours need food too. Many children on our street go to school
        hungry.
      mood: 6
      gesture: 0
      holdSeconds: 0
    - text: Come to my stall. We'll sell some at a fair price, for everyone.
      mood: 1
      gesture: 3
      holdSeconds: 0
    focusCamera: 1
    waitForInput: 1
  success:
    lines:
    - text: R{earned}! That's bread and milk for the week. Siyabonga!
      mood: 2
      gesture: 0
      holdSeconds: 0
    focusCamera: 0
    waitForInput: 0
  nudge:
    lines:
    - text: Meet me at the stall, my child. Bring the tomatoes.
      mood: 0
      gesture: 0
      holdSeconds: 0
    focusCamera: 0
    waitForInput: 0
