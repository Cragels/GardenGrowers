  objective: 
  designNote: Hook and theme first. Gogo walks up, the camera watches her. Food insecurity
    is shown through the family's situation, not a lecture.
  targetId: 
  gogo: 1
  gogoTargetId: 
  intro:
    lines:
    - text: Sawubona, mzukulu! You're up early.
      mood: 1
      gesture: 2
      holdSeconds: 0
    - text: I checked the kitchen. Only a little mealie meal is left.
      mood: 5
      gesture: 0
      holdSeconds: 0
    - text: Food costs more every month. Our money doesn't stretch like it used to.
      mood: 6
      gesture: 0
      holdSeconds: 0
    - text: But look at this yard. Before the rubbish came, it fed our whole family.
      mood: 4
      gesture: 0
      holdSeconds: 0
    - text: Let's make it grow again. You and me!
      mood: 2
      gesture: 0
      holdSeconds: 0
    focusCamera: 1
    waitForInput: 1
