  intro:
    lines:
    - text: These are my last tomato seeds. I kept them for a special day.
      mood: 3
      gesture: 0
      holdSeconds: 0
    - text: Today is that day. Plant them in your soil.
      mood: 1
      gesture: 3
      holdSeconds: 0
    focusCamera: 1
    waitForInput: 1
  success:
    lines:
    - text: One little seed can grow food for many meals.
      mood: 3
      gesture: 0
      holdSeconds: 0
    focusCamera: 0
    waitForInput: 0
  nudge:
    lines:
    - text: Hold the seeds like you held the spade. Then plant them.
      mood: 4
      gesture: 0
      holdSeconds: 0
    focusCamera: 0
    waitForInput: 0
